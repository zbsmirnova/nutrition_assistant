          "title": "Candidate Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "candidate_ref",
        "candidate_kind"
      ],
      "title": "CandidateReference",
      "type": "object"
    },
    "CompleteTotal": {
