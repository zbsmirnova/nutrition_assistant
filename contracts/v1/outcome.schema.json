{
  "$defs": {
    "Applied": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "outcome": {
          "const": "applied",
          "title": "Outcome",
          "type": "string"
        },
        "mutations": {
          "items": {
            "$ref": "#/$defs/MutationReceipt"
          },
          "minItems": 1,
          "title": "Mutations",
          "type": "array"
        },
        "food_entries": {
          "items": {
            "$ref": "#/$defs/FoodEntrySummary"
          },
          "title": "Food Entries",
          "type": "array"
        },
        "observations": {
          "items": {
            "discriminator": {
              "mapping": {
                "daily_steps": "#/$defs/StepsSnapshot",
                "daily_weight": "#/$defs/WeightSnapshot"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/WeightSnapshot"
              },
              {
                "$ref": "#/$defs/StepsSnapshot"
              }
            ]
          },
          "title": "Observations",
          "type": "array"
        },
        "daily_summaries": {
          "items": {
            "$ref": "#/$defs/DailySummary"
          },
          "title": "Daily Summaries",
          "type": "array"
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecipeProfile"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "outcome",
        "mutations",
        "food_entries",
        "observations",
        "daily_summaries",
        "recipe"
      ],
      "title": "Applied",
      "type": "object"
    },
    "CandidateReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "candidate",
          "title": "Kind",
          "type": "string"
