        "kcal": {
          "discriminator": {
            "mapping": {
              "complete": "#/$defs/CompleteTotal",
              "empty": "#/$defs/EmptyTotal",
              "partial": "#/$defs/PartialTotal",
              "unknown": "#/$defs/UnknownTotal"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteTotal"
            },
            {
              "$ref": "#/$defs/PartialTotal"
            },
            {
              "$ref": "#/$defs/UnknownTotal"
            },
            {
              "$ref": "#/$defs/EmptyTotal"
            }
          ],
          "title": "Kcal"
        },
        "protein_g": {
          "discriminator": {
            "mapping": {
              "complete": "#/$defs/CompleteTotal",
              "empty": "#/$defs/EmptyTotal",
              "partial": "#/$defs/PartialTotal",
              "unknown": "#/$defs/UnknownTotal"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteTotal"
            },
            {
              "$ref": "#/$defs/PartialTotal"
            },
            {
              "$ref": "#/$defs/UnknownTotal"
            },
            {
              "$ref": "#/$defs/EmptyTotal"
            }
          ],
          "title": "Protein G"
        },
        "fat_g": {
          "discriminator": {
            "mapping": {
              "complete": "#/$defs/CompleteTotal",
              "empty": "#/$defs/EmptyTotal",
              "partial": "#/$defs/PartialTotal",
              "unknown": "#/$defs/UnknownTotal"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteTotal"
            },
            {
              "$ref": "#/$defs/PartialTotal"
            },
            {
              "$ref": "#/$defs/UnknownTotal"
            },
            {
              "$ref": "#/$defs/EmptyTotal"
            }
          ],
          "title": "Fat G"
        },
        "carbs_g": {
          "discriminator": {
            "mapping": {
              "complete": "#/$defs/CompleteTotal",
              "empty": "#/$defs/EmptyTotal",
              "partial": "#/$defs/PartialTotal",
              "unknown": "#/$defs/UnknownTotal"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteTotal"
            },
            {
              "$ref": "#/$defs/PartialTotal"
            },
            {
              "$ref": "#/$defs/UnknownTotal"
            },
            {
              "$ref": "#/$defs/EmptyTotal"
            }
          ],
          "title": "Carbs G"
        }
      },
      "required": [
        "kcal",
        "protein_g",
        "fat_g",
        "carbs_g"
