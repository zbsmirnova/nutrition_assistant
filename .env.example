# Non-secret configuration template for the Nebius adapter.
# Inject the actual key through your local/runtime secret mechanism.
# This application does not automatically load .env files.
# Setting these variables does not run inference. Use an explicit operator command.
# Start with nebius-smoke, which sends only one fixed synthetic input and does not use the DB.
NEBIUS_API_KEY=

# Exact Nebius model ID; selection follows Russian-message evaluation.
# No model default is assumed and no credentials belong here.
NUTRITION_LLM_MODEL=

# Optional external cold-start food lookup. USDA requires a secret API key;
# Open Food Facts uses this identifying header and does not require a key.
USDA_FDC_API_KEY=
NUTRITION_FOOD_USER_AGENT=NutritionAssistant/1.0 (contact@example.invalid)

# Production Compose values. Keep secrets out of the repository and use a
# long random alphanumeric PostgreSQL password for the internal Compose URL.
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=
POSTGRES_DB=nutrition
NUTRITION_INTERNAL_USER_ID=
