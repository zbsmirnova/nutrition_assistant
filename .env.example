# Non-secret configuration template for the Nebius adapter.
# Inject the actual key through your local/runtime secret mechanism.
# This application does not automatically load .env files.
# Setting these variables does not run inference. Use an explicit operator command.
# Start with nebius-smoke, which sends only one fixed synthetic input and does not use the DB.
NEBIUS_API_KEY=

# Exact Nebius model ID; selection follows Russian-message evaluation.
# No model default is assumed and no credentials belong here.
NUTRITION_LLM_MODEL=
