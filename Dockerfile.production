FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements-runtime.txt requirements-contracts.txt ./
RUN pip install --no-cache-dir -r requirements-runtime.txt -r requirements-contracts.txt
COPY nutrition_app nutrition_app
COPY nutrition_contracts nutrition_contracts
COPY migrations migrations
COPY alembic.ini .

ENTRYPOINT ["python", "-m", "nutrition_app"]
